
# Application settings
APP_NAME=CodeAtlas Backend
APP_VERSION=1.0.0

# Database configuration (to be configured later)
DATABASE_URL=

# Trusted local TypeScript AST service (read directly from the process environment)
CODEATLAS_AST_BASE_URL=http://127.0.0.1:5000

# Python metadata persistence; resolved relative to the Python process directory.
CODEATLAS_METADATA_ROOT=data/metadata
# Across processes sharing this root; each project processes files sequentially.
CODEATLAS_METADATA_MAX_ACTIVE=2
CODEATLAS_METADATA_MAX_FILES=1000
CODEATLAS_METADATA_MAX_BYTES=134217728
CODEATLAS_METADATA_FILE_BYTES=16777216
CODEATLAS_METADATA_TIMEOUT_SECONDS=120
